{
  "name": "Coder (from plan)",
  "context": "coderepos",
  "description": "Fires the task description as a claude --remote prompt piped to FlightDesk. No local session \u2014 TaskOS runs the command directly.",
  "command": "cd \"$([ -d \"$HOME/workspaces/nestled\" ] && printf %s \"$HOME/workspaces/nestled\" || printf %s \"$HOME/IdeaProjects/nestled\")\" && flightdesk register --project 92691b61-d070-4460-98f9-6c3b7ce1ee47 --title '{title}' --prompt '{description}'",
  "output_rules": [
    {
      "pattern": "Task ID: ([a-f0-9-]{36})",
      "action": "add_link",
      "url": "https://flightdesk.dev/app/tasks/{1}"
    }
  ],
  "project": "nestled",
  "coding": true
}
