{
  "name": "Coder (from task)",
  "context": "coderepos",
  "description": "Compiles task title, description, links, and attachments into a spec and fires it directly at claude --remote. No local intermediary \u2014 TaskOS runs the command itself.",
  "command": "cd \"$([ -d \"$HOME/workspaces/nestled\" ] && printf %s \"$HOME/workspaces/nestled\" || printf %s \"$HOME/IdeaProjects/nestled\")\" && flightdesk register --project 92691b61-d070-4460-98f9-6c3b7ce1ee47 --title '{title}' --prompt '{description}'",
  "project": "nestled"
}
