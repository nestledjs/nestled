{
  "name": "upgrades",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "upgrades/src",
  "projectType": "library",
  "publishable": true,
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/upgrades",
        "main": "upgrades/src/index.ts",
        "tsConfig": "upgrades/tsconfig.lib.json",
        "assets": [
          "upgrades/*.md",
          {
            "input": "./upgrades/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./upgrades/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          }
        ]
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "cwd": "upgrades",
        "command": "eslint ."
      }
    }
  }
}
